{
  "name": "ARK: Survival Ascended",
  "exe": [
    "ArkAscended.exe"
  ],
  "art": {
    "steamAppId": 2399830
  },
  "offlineOnly": true,
  "offlineNote": "Mods only work in single-player and on servers without BattlEye. Leave them off on BattlEye servers, including your own if BattlEye is on. Commands, the Library and the map work everywhere.",
  "info": [
    {
      "title": "Commands on your server",
      "body": "Open Commands in Keystone's sidebar. Spawning and giving items run in your game's console, so they act on your character. Server-wide commands like saving the world go over RCON."
    },
    {
      "title": "Becoming admin in game",
      "body": "Save your server's admin password in Command settings, then press Log in as admin once per session. Keystone types EnableCheats for you."
    }
  ],
  "library": {
    "sections": [
      {
        "id": "creatures",
        "label": "Creatures",
        "catalog": "creatures",
        "idLabel": "Creature ID"
      },
      {
        "id": "items",
        "label": "Items",
        "catalog": "items",
        "idLabel": "Class name"
      }
    ],
    "guides": "guides",
    "wiki": {
      "label": "ARK Wiki",
      "page": "https://ark.wiki.gg/wiki/{name}"
    },
    "links": [
      {
        "label": "ARK Wiki",
        "url": "https://ark.wiki.gg/wiki/ARK_Survival_Ascended"
      },
      {
        "label": "wikily",
        "url": "https://wikily.gg/ark-survival-ascended/"
      }
    ]
  },
  "commands": {
    "credits": "Creature and item IDs from the ARK Wiki (ark.wiki.gg), community-maintained.",
    "console": {
      "key": "Tab",
      "prefixes": [
        "admincheat",
        "cheat",
        ""
      ],
      "enable": "EnableCheats {password}"
    },
    "rcon": {
      "port": 27020
    },
    "catalogs": {
      "creatures": "creatures.json",
      "items": "items.json"
    },
    "actions": [
      {
        "id": "summon-tamed",
        "label": "Spawn tamed",
        "catalog": "creatures",
        "via": "console",
        "template": "GMSummon \"{id}\" {level}",
        "help": "Spawns a tamed creature next to you. The level is its level after taming.",
        "fields": [
          {
            "key": "level",
            "label": "Level",
            "type": "number",
            "default": 150,
            "min": 1,
            "max": 1000
          },
          {
            "key": "count",
            "label": "How many",
            "type": "number",
            "default": 1,
            "min": 1,
            "max": 20,
            "repeat": true
          }
        ]
      },
      {
        "id": "summon-wild",
        "label": "Spawn wild",
        "catalog": "creatures",
        "via": "console",
        "template": "Summon \"{id}\"",
        "help": "Spawns a wild creature at a random level next to you.",
        "fields": [
          {
            "key": "count",
            "label": "How many",
            "type": "number",
            "default": 1,
            "min": 1,
            "max": 20,
            "repeat": true
          }
        ]
      },
      {
        "id": "give-item",
        "label": "Give to me",
        "catalog": "items",
        "via": "console",
        "template": "GiveItem \"Blueprint'{blueprint}'\" {qty} {quality} {blueprintOnly}",
        "help": "Puts the item in your own inventory.",
        "fields": [
          {
            "key": "qty",
            "label": "Quantity",
            "type": "number",
            "default": 1,
            "min": 1,
            "max": 10000
          },
          {
            "key": "quality",
            "label": "Quality",
            "type": "number",
            "default": 0,
            "min": 0,
            "max": 100
          },
          {
            "key": "blueprintOnly",
            "label": "Blueprint instead of item",
            "type": "toggle",
            "default": false
          }
        ]
      },
      {
        "id": "give-item-player",
        "label": "Give to a player",
        "catalog": "items",
        "via": "rcon",
        "template": "GiveItemToPlayer {playerId} \"Blueprint'{blueprint}'\" {qty} {quality} {blueprintOnly}",
        "help": "Sends the item to another player over RCON. Their player ID is the number shown next to their name in ShowMyAdminManager.",
        "fields": [
          {
            "key": "playerId",
            "label": "Player ID",
            "type": "text",
            "pattern": "^[0-9]{1,20}$",
            "patternHelp": "The player ID is a number.",
            "max": 20
          },
          {
            "key": "qty",
            "label": "Quantity",
            "type": "number",
            "default": 1,
            "min": 1,
            "max": 10000
          },
          {
            "key": "quality",
            "label": "Quality",
            "type": "number",
            "default": 0,
            "min": 0,
            "max": 100
          },
          {
            "key": "blueprintOnly",
            "label": "Blueprint instead of item",
            "type": "toggle",
            "default": false
          }
        ]
      }
    ],
    "quick": [
      {
        "id": "god",
        "label": "God mode",
        "via": "console",
        "template": "God",
        "help": "Toggles invulnerability."
      },
      {
        "id": "infinite-stats",
        "label": "Infinite stats",
        "via": "console",
        "template": "InfiniteStats",
        "help": "Toggles unlimited health, stamina, food, water and weight."
      },
      {
        "id": "fly",
        "label": "Fly",
        "via": "console",
        "template": "Fly"
      },
      {
        "id": "walk",
        "label": "Stop flying",
        "via": "console",
        "template": "Walk",
        "help": "Ends Fly and Ghost."
      },
      {
        "id": "ghost",
        "label": "Walk through walls",
        "via": "console",
        "template": "Ghost"
      },
      {
        "id": "force-tame",
        "label": "Tame what I'm aiming at",
        "via": "console",
        "template": "ForceTame"
      },
      {
        "id": "leave-me-alone",
        "label": "Leave me alone",
        "via": "console",
        "template": "LeaveMeAlone",
        "help": "God mode, infinite stats and creatures ignore you."
      },
      {
        "id": "add-xp",
        "label": "Give me experience",
        "via": "console",
        "template": "AddExperience {amount} 0 0",
        "fields": [
          {
            "key": "amount",
            "label": "Experience",
            "type": "number",
            "default": 10000,
            "min": 1,
            "max": 100000000
          }
        ]
      },
      {
        "id": "time",
        "label": "Set time of day",
        "via": "rcon",
        "template": "SetTimeOfDay {time}",
        "fields": [
          {
            "key": "time",
            "label": "Time (hh:mm)",
            "type": "text",
            "default": "12:00",
            "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
            "patternHelp": "Use 24-hour time like 07:30 or 19:00.",
            "max": 5
          }
        ]
      },
      {
        "id": "save",
        "label": "Save the world",
        "via": "rcon",
        "template": "SaveWorld"
      },
      {
        "id": "players",
        "label": "List players",
        "via": "rcon",
        "template": "ListPlayers"
      },
      {
        "id": "chat",
        "label": "Message everyone",
        "via": "rcon",
        "template": "ServerChat {message}",
        "fields": [
          {
            "key": "message",
            "label": "Message",
            "type": "text",
            "max": 200
          }
        ]
      },
      {
        "id": "wipe-wild",
        "label": "Remove all wild creatures",
        "via": "rcon",
        "template": "DestroyWildDinos",
        "confirm": "Remove every wild creature on the server? They respawn over time, but anything you were taming is gone."
      }
    ]
  }
}
