{
  "name": "keystone",
  "version": "0.34.1",
  "description": "Mod control panel for single-player PC games: Cheat Engine tables as toggles, phone remote, in-game overlay.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "capture": "electron scripts/capture.js",
    "dist": "electron-builder --win --x64 --publish never",
    "dist:dir": "electron-builder --dir --publish never"
  },
  "license": "MIT",
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "iced-x86": "^1.21.0",
    "koffi": "^3.3.2",
    "marked": "^18.0.14",
    "qrcode": "^1.5.4",
    "wasmoon": "^1.16.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "productName": "Keystone",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "author": "Tanner",
  "build": {
    "appId": "com.tanner.keystone",
    "productName": "Keystone",
    "copyright": "Copyright © 2026 Tanner",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "packs/**",
      "tables/**",
      "assets/**",
      "package.json",
      "LICENSE"
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/**",
      "node_modules/iced-x86/**",
      "node_modules/wasmoon/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Keystone",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "assets/icon.png"
    },
    "publish": []
  }
}
