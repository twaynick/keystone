<?xml version="1.0" encoding="utf-8"?>
<!-- Cheat table for Keystone's built-in demo game. Written in Cheat Engine's
     own format so the demo exercises the same parser real tables go through.
     Note: CE lists <Offsets> last-applied-first, so Wood's chain
     [[demo.exe+2000]+40]+8 is stored as 8, then 40. -->
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>1</ID>
      <Description>"Player"</Description>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>2</ID>
          <Description>"Health"</Description>
          <VariableType>Float</VariableType>
          <Address>demo.exe+2000</Address>
          <Offsets><Offset>10</Offset></Offsets>
        </CheatEntry>
        <CheatEntry>
          <ID>3</ID>
          <Description>"Stamina"</Description>
          <VariableType>Float</VariableType>
          <Address>demo.exe+2000</Address>
          <Offsets><Offset>14</Offset></Offsets>
        </CheatEntry>
        <CheatEntry>
          <ID>4</ID>
          <Description>"Ammo in clip"</Description>
          <VariableType>4 Bytes</VariableType>
          <Address>demo.exe+2000</Address>
          <Offsets><Offset>18</Offset></Offsets>
        </CheatEntry>
        <CheatEntry>
          <ID>5</ID>
          <Description>"Gold"</Description>
          <VariableType>4 Bytes</VariableType>
          <Address>demo.exe+2000</Address>
          <Offsets><Offset>1C</Offset></Offsets>
        </CheatEntry>
        <CheatEntry>
          <ID>6</ID>
          <Description>"God mode"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{ A patch script: finds the code that takes damage by its bytes and
  replaces it with NOPs (do nothing). [DISABLE] puts the original bytes back. }
[ENABLE]
aobscanmodule(HURT,demo.exe,F3 0F 5C C1 F3 0F 11 47 10) // subss xmm0,xmm1 / movss [rdi+10],xmm0
registersymbol(HURT)

HURT:
  nop 9

[DISABLE]
HURT:
  db F3 0F 5C C1 F3 0F 11 47 10

unregistersymbol(HURT)
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>7</ID>
          <Description>"Infinite ammo"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{ Cheat Engine's "AOB injection" template: the game's code jumps to a
  code cave (newmem) that runs everything except the line using a bullet,
  then jumps back. }
[ENABLE]
aobscanmodule(AMMO,demo.exe,FF 4F 18 48 8B 4B 08) // should be unique
alloc(newmem,$1000,AMMO)

label(code)
label(return)

newmem:
  // the bullet isn't taken
code:
  mov rcx,[rbx+08]
  jmp return

AMMO:
  jmp newmem
  nop 2
return:
registersymbol(AMMO)

[DISABLE]
AMMO:
  db FF 4F 18 48 8B 4B 08
  // dec dword ptr [rdi+18]
  // mov rcx,[rbx+08]

unregistersymbol(AMMO)
dealloc(newmem)
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>8</ID>
          <Description>"Gold rain (Lua)"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{$lua}
-- A Lua script: a timer adds 100 gold every second while it's on.
if syntaxcheck then return end
[ENABLE]
goldRain = createTimer(nil, false)
goldRain.Interval = 1000
goldRain.OnTimer = function()
  local p = readPointer("demo.exe+2000")
  if p and p ~= 0 then writeInteger(p + 0x1C, readInteger(p + 0x1C) + 100) end
end
goldRain.Enabled = true

[DISABLE]
if goldRain then goldRain.destroy(); goldRain = nil end
</AssemblerScript>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>
    <CheatEntry>
      <ID>10</ID>
      <Description>"Inventory"</Description>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>11</ID>
          <Description>"Wood"</Description>
          <VariableType>4 Bytes</VariableType>
          <Address>demo.exe+2000</Address>
          <Offsets><Offset>8</Offset><Offset>40</Offset></Offsets>
        </CheatEntry>
        <CheatEntry>
          <ID>12</ID>
          <Description>"Stone"</Description>
          <VariableType>4 Bytes</VariableType>
          <Address>demo.exe+2000</Address>
          <Offsets><Offset>C</Offset><Offset>40</Offset></Offsets>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>
    <CheatEntry>
      <ID>20</ID>
      <Description>"Position"</Description>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>21</ID>
          <Description>"X"</Description>
          <VariableType>Float</VariableType>
          <Address>[demo.exe+2000]+30</Address>
        </CheatEntry>
        <CheatEntry>
          <ID>22</ID>
          <Description>"Y"</Description>
          <VariableType>Float</VariableType>
          <Address>[demo.exe+2000]+34</Address>
        </CheatEntry>
        <CheatEntry>
          <ID>23</ID>
          <Description>"Z (height)"</Description>
          <VariableType>Float</VariableType>
          <Address>[demo.exe+2000]+38</Address>
        </CheatEntry>
        <CheatEntry>
          <ID>24</ID>
          <Description>"Facing (degrees)"</Description>
          <VariableType>Float</VariableType>
          <Address>[demo.exe+2000]+3C</Address>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>
  </CheatEntries>
</CheatTable>
