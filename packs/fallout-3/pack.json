{
  "name": "Fallout 3",
  "exe": [
    "Fallout3.exe"
  ],
  "art": {
    "steamAppId": 22370
  },
  "maps": [
    {
      "id": "capital-wasteland",
      "name": "Capital Wasteland",
      "picture": "Capital Wasteland map.jpg"
    }
  ],
  "info": [
    {
      "title": "Commands",
      "body": "Open Commands on this game's page. Keystone opens the console with the ~ key, types the command, presses Enter and closes the console again."
    },
    {
      "title": "DLC items",
      "body": "The item list covers the base game. DLC item IDs depend on your load order; the Form IDs guide in the Library explains how to work them out."
    },
    {
      "title": "Overlay",
      "body": "Fallout 3 has no borderless mode of its own. Run it windowed (Fallout Launcher, Options) for the overlay and browser to show on top."
    }
  ],
  "commands": {
    "credits": "Item names, Form IDs and pictures from Nukapedia, the Fallout Wiki on Fandom (fallout.fandom.com), community-maintained. Base game only.",
    "console": {
      "key": "Backquote",
      "prefixes": [
        ""
      ],
      "keepsOpen": true,
      "paste": false
    },
    "catalogs": {
      "items": "items.json"
    },
    "actions": [
      {
        "id": "give-item",
        "label": "Give to me",
        "catalog": "items",
        "template": "player.additem {id} {qty}",
        "help": "Adds the item to your inventory.",
        "fields": [
          {
            "key": "qty",
            "label": "Quantity",
            "type": "number",
            "default": 1,
            "min": 1,
            "max": 100000
          }
        ]
      },
      {
        "id": "drop-item",
        "label": "Drop at my feet",
        "catalog": "items",
        "template": "player.placeatme {id} {qty}",
        "help": "Places the item on the ground next to you.",
        "fields": [
          {
            "key": "qty",
            "label": "Quantity",
            "type": "number",
            "default": 1,
            "min": 1,
            "max": 100
          }
        ]
      }
    ],
    "quick": [
      {
        "id": "tgm",
        "label": "God mode",
        "template": "tgm",
        "help": "Toggles no damage, no radiation, unlimited ammo and Action Points, and no carry limit."
      },
      {
        "id": "tcl",
        "label": "No clip",
        "template": "tcl",
        "help": "Toggles walking through walls and flying."
      },
      {
        "id": "tfc",
        "label": "Free camera",
        "template": "tfc",
        "help": "Toggles a camera you can fly around, for screenshots."
      },
      {
        "id": "tm",
        "label": "Hide the HUD",
        "template": "tm",
        "help": "Toggles all on-screen menus. Run it again to bring them back."
      },
      {
        "id": "tmm",
        "label": "Show every map location",
        "template": "tmm 1",
        "help": "Reveals every map marker and makes them fast-travel points. This can't be undone in this save."
      },
      {
        "id": "caps",
        "label": "Give me caps",
        "template": "player.additem 0000000F {amount}",
        "fields": [
          {
            "key": "amount",
            "label": "Caps",
            "type": "number",
            "default": 1000,
            "min": 1,
            "max": 1000000
          }
        ]
      },
      {
        "id": "advlevel",
        "label": "Level up once",
        "template": "player.advlevel",
        "help": "Takes you up one level, with the level-up screen. XP stays where it is."
      },
      {
        "id": "level",
        "label": "Set my level",
        "template": "player.setlevel {level}",
        "fields": [
          {
            "key": "level",
            "label": "Level",
            "type": "number",
            "default": 20,
            "min": 1,
            "max": 30
          }
        ],
        "help": "Fallout 3 caps at 20, or 30 with Broken Steel."
      },
      {
        "id": "special",
        "label": "Set a S.P.E.C.I.A.L. stat",
