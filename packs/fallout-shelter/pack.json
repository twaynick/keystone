  "info": [
    {
      "title": "Library",
      "body": "Every dweller, weapon, outfit and pet in Fallout Shelter (100 dwellers, 249 weapons, 179 outfits, 62 pets) and all 28 rooms, with pictures and links to Nukapedia."
    },
    {
      "title": "Back up your vault first",
      "body": "Fallout Shelter saves to %LOCALAPPDATA%\\FalloutShelter (Vault1.sav to Vault3.sav). Copy that folder before using mods: a value set too high can break a save, and with cloud saves on, a broken vault can sync to your other devices."
    },
    {
      "title": "Overlay",
      "body": "Run the game in a window rather than fullscreen for the overlay and Keystone's browser to show on top."
    }
  ],
