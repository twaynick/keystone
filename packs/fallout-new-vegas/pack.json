              },
              {
                "value": "guns",
                "label": "Guns"
              },
              {
                "value": "lockpick",
                "label": "Lockpick"
              },
              {
                "value": "medicine",
                "label": "Medicine"
              },
              {
                "value": "meleeweapons",
                "label": "Melee Weapons"
              },
              {
                "value": "repair",
                "label": "Repair"
              },
              {
                "value": "science",
                "label": "Science"
              },
              {
                "value": "sneak",
                "label": "Sneak"
              },
              {
                "value": "speech",
                "label": "Speech"
              },
              {
                "value": "survival",
                "label": "Survival"
              },
              {
                "value": "unarmed",
                "label": "Unarmed"
              }
            ]
          },
          {
            "key": "value",
            "label": "Value",
            "type": "number",
            "default": 100,
            "min": 1,
            "max": 100
          }
        ]
      },
      {
        "id": "karma",
        "label": "Change my Karma",
        "template": "RewardKarma {amount}",
        "help": "Use a negative number to lower it.",
        "fields": [
          {
            "key": "amount",
            "label": "Karma",
            "type": "number",
            "default": 500,
            "min": -10000,
            "max": 10000
          }
        ]
      },
      {
        "id": "xp",
        "label": "Give me XP",
        "template": "player.rewardXP {amount}",
        "fields": [
          {
            "key": "amount",
            "label": "XP",
            "type": "number",
            "default": 1000,
            "min": 1,
            "max": 1000000
          }
        ]
      },
      {
        "id": "carry",
        "label": "Add carry weight",
        "template": "player.modav carryweight {amount}",
        "fields": [
          {
            "key": "amount",
            "label": "Extra pounds",
            "type": "number",
            "default": 500,
            "min": 1,
            "max": 100000
          }
        ]
      },
      {
        "id": "hardcore",
        "label": "Hardcore mode",
        "template": "player.sethardcore {on}",
        "help": "Turns Hardcore mode on or off. Turning it off mid-game forfeits the Hardcore achievement for that run.",
        "fields": [
          {
            "key": "on",
            "label": "Hardcore",
            "type": "choice",
            "options": [
              {
                "value": "1",
                "label": "On"
              },
              {
                "value": "0",
                "label": "Off"
              }
            ]
          }
        ]
      },
      {
        "id": "time",
        "label": "Set time of day",
        "template": "set gamehour to {hour}",
        "fields": [
          {
            "key": "hour",
            "label": "Hour (0 to 23)",
            "type": "number",
            "default": 12,
            "min": 0,
            "max": 23
          }
        ]
      },
      {
        "id": "race",
        "label": "Change my face",
        "template": "showracemenu",
        "help": "Opens the character editor."
      },
      {
        "id": "killall",
        "label": "Kill everyone nearby",
        "template": "killall",
        "help": "Kills every non-essential character in the area.",
        "confirm": "Kill every non-essential character nearby? Quest characters you can't see may be among them, and killing them can fail quests."
      }
    ]
  },
