              },
              {
                "value": "charisma",
                "label": "Charisma"
              },
              {
                "value": "intelligence",
                "label": "Intelligence"
              },
              {
                "value": "agility",
                "label": "Agility"
              },
              {
                "value": "luck",
                "label": "Luck"
              }
            ]
          },
          {
            "key": "value",
            "label": "Value",
            "type": "number",
            "default": 10,
            "min": 1,
            "max": 10
          }
        ]
      },
      {
        "id": "skill",
        "label": "Set a skill",
        "template": "player.setav {skill} {value}",
        "fields": [
          {
            "key": "skill",
            "label": "Skill",
            "type": "choice",
            "options": [
              {
                "value": "barter",
                "label": "Barter"
              },
              {
